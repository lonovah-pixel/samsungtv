<?xml version="1.0" encoding="utf-8"?>
<!--
  Минимальный файл ответов WinIso.
  Содержит ТОЛЬКО проход oobeSystem с командой первого входа (установка программ).
  Намеренно отсутствуют: проход windowsPE (выбор языка, редакции и ДИСКА остаётся ручным),
  разметка и очистка дисков, ключи продукта, учётные записи и их секреты, автологин,
  обход аппаратных требований. Все экраны OOBE остаются интерактивными.
  FirstLogonCommands выполняются при первом входе пользователя, созданного в OOBE
  (администратор по умолчанию), с повышенными правами.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="{{ARCH}}" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>WinIso: install applications (idempotent)</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Minimized -File "{{FIRST_LOGON_SCRIPT}}" -Stage FirstLogon</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
